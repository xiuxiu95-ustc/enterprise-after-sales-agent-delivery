APP_ENV=local
HOST=127.0.0.1
PORT=8001
DATABASE_URL=sqlite:///./data/enterprise_after_sales.db
AUTH_REQUIRED=false
LOCAL_API_TOKEN=replace-in-production
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Agent runtime
MAX_AGENT_STEPS=6
CONTEXT_WINDOW_TOKENS=8000
CONTEXT_SUMMARY_RATIO=0.60
RECENT_MESSAGE_LIMIT=10

# Integrated slot backend. Relative paths resolve from the repository root.
SLOT_EXTRACTOR_REPO=packages/slot_extractor
SLOT_EXTRACTOR_BACKEND_CONFIG=

# Integrated RAG MCP component.
# mode: mcp | inprocess | local. local is deterministic development fallback only.
RAG_MODE=local
RAG_MCP_REPO=packages/modular_rag_mcp
RAG_COLLECTION=enterprise_after_sales

# AutoDream
AUTODREAM_MIN_CLOSED_SESSIONS=5
AUTODREAM_MIN_INTERVAL_HOURS=24
AUTODREAM_LOCK_SECONDS=300
